{
  "name": "PROJECT_NAME",
  "version": "0.1.0",
  "private": true,
  "description": "Express.js + React client-server application with TypeScript and monorepo structure.",
  "author": "OpenClaw Scaffolding Engine",
  "license": "MIT",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspaces",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "start:client": "npm run preview --workspace=client",
    "start:server": "npm run start --workspace=server",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "test": "npm run test --workspaces",
    "test:client": "npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:coverage": "npm run test:coverage --workspaces",
    "type-check": "npm run type-check --workspaces",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.56.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "express",
    "react",
    "typescript",
    "monorepo",
    "client-server",
    "scaffolding"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/PROJECT_NAME.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/PROJECT_NAME/issues"
  },
  "homepage": "https://github.com/your-username/PROJECT_NAME#readme",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}